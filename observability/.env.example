# ─────────────────────────────────────────────────────────────────────────────
# Rejki Backend — Observability Stack (.env)
# Letakkan di: observability/.env
# Template: observability/.env.example
# ─────────────────────────────────────────────────────────────────────────────

# ── Grafana Cloud OpenTelemetry ──────────────────────────────────────────────
# Dari wizard: Linux + OpenTelemetry Collector
# Endpoint dari: GRAFANA_CLOUD_OTLP_ENDPOINT
GRAFANA_OTEL_ENDPOINT=https://otlp-gateway-prod-ap-southeast-2.grafana.net/otlp

# Auth header: base64 dari "1699861:your-grafana-cloud-access-token"
# Cara buat: echo -n "1699861:glc_xxxxx" | base64 -w0
GRAFANA_OTEL_AUTH_HEADER=Authorization=Basic MTY5OTg2MTpnbGNfeHh4eHh4eHh4eHh4

# ── Grafana Loki (Logs) ──────────────────────────────────────────────────────
# Dapatkan dari: Grafana Cloud → Loki → Send logs → pilih "Docker" atau "Generic"
# URL: dari wizard Loki
GRAFANA_LOKI_URL=https://logs-{zone}.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USER=1699861
GRAFANA_LOKI_TOKEN=your-grafana-cloud-access-token

# ── PostgreSQL (shared — untuk pg_exporter) ──────────────────────────────────
# Harus sama dengan password di .env prod (karena pg_exporter connect ke rejki_postgres)
POSTGRES_PASSWORD=CHANGE_ME_PROD_STRONG
