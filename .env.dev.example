# ─────────────────────────────────────────────────────────────────────────────
# Rejki Backend — Dev Environment (.env)
# Letakkan di: /opt/rejki/dev/.env
# JANGAN commit file ini ke git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=development
RUST_LOG=debug

# ── Database (shared PostgreSQL, database: rejki_dev) ────────────────────────
POSTGRES_PASSWORD=CHANGE_ME_DEV
DATABASE_URL=postgres://rejki:${POSTGRES_PASSWORD}@postgres:5432/rejki_dev
REDIS_URL=redis://redis:6379/0

# ── App ──────────────────────────────────────────────────────────────────────
APP_PORT=8080
CORS_ALLOWED_ORIGINS=http://dev.rejki.id
DEV_DOMAIN=dev.rejki.id

# ── JWT (RS256) — generate keypair dan letakkan di /opt/rejki/keys/ ──────────
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000

# ── Encryption at Rest ───────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# ── Firebase Cloud Messaging (DEV project) ──────────────────────────────────
# Letakkan service-account JSON di: /opt/rejki/keys/firebase-service-account-dev.json
FIREBASE_SERVICE_ACCOUNT_PATH=/app/keys/firebase-service-account-dev.json
FIREBASE_PROJECT_ID_DEV=rejki-dev

# ── Email / SMTP (DEV — gunakan Mailtrap atau dummy) ────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME_DEV=your-mailtrap-username
SMTP_PASSWORD_DEV=your-mailtrap-password
EMAIL_FROM=Rejki Dev <noreply@dev.rejki.id>

# ── MinIO (shared) ──────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=rejkiadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=rejki-dokumen-dev

# ── DB Backup ────────────────────────────────────────────────────────────────
BACKUP_SCHEDULE=0 4 * * *

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Satu tunnel yang sama dengan production — beda port di Cloudflare Dashboard
TUNNEL_TOKEN=CHANGE_ME_TUNNEL_TOKEN

# ── OpenTelemetry Auth (opsional — hanya jika pakai Grafana Cloud tracing) ──
# OTEL header untuk autentikasi ke collector. Endpoint sudah di-set di compose.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic {base64_credentials}

# ── Grafana Cloud / OpenTelemetry (opsional) ────────────────────────────────
# Uncomment & isi nilai dari Grafana Cloud stack Anda untuk mengaktifkan tracing.
# Setup: https://grafana.com/ → Grafana Cloud → OpenTelemetry → Send OpenTelemetry data
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-grpc.{zone}.grafana.net:4317
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic {base64_credentials}
