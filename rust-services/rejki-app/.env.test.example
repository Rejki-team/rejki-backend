# Template konfigurasi untuk menjalankan integration test di MESIN LOKAL.
# Salin menjadi `.env.test` lalu sesuaikan nilainya. JANGAN commit `.env.test`.
#
# Memakai infrastruktur lokal (Docker/Podman: container Postgres dev).
# CI (GitHub Actions) TIDAK memakai file ini — CI meng-override DATABASE_URL
# via env var ke DB ephemeral rejki_test (lihat .github/workflows/ci.yml).
# Peringatan: integration test menulis & menghapus data (clean_test_data) di DB ini.
APP_ENV=development
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME
REDIS_URL=redis://localhost:6379/1
APP_PORT=0
SERVICE_NAME=rejki-test
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL_SECS=900
