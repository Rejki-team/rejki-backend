  "query": "INSERT INTO chat.conversations (id, user_a, user_b)\n               VALUES (gen_random_uuid(), $1, $2)\n               ON CONFLICT (user_a, user_b) DO UPDATE SET id = chat.conversations.id\n               RETURNING id, user_a, user_b, created_at",
