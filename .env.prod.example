# ─────────────────────────────────────────────────────────────────────────────
# Rejki Backend — Production Environment (.env)
# Letakkan di: /opt/rejki/prod/.env
# JANGAN commit file ini ke git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
APP_ENV=production
RUST_LOG=warn

# ── Database (shared PostgreSQL, database: rejki_prod) ───────────────────────
POSTGRES_PASSWORD=CHANGE_ME_PROD_STRONG
DATABASE_URL=postgres://rejki:${POSTGRES_PASSWORD}@postgres:5432/rejki_prod
REDIS_URL=redis://redis:6379/1

# ── App ──────────────────────────────────────────────────────────────────────
APP_PORT=8080
CORS_ALLOWED_ORIGINS=https://rejki.id,https://app.rejki.id
PROD_DOMAIN=rejki.id
APP_DOMAIN=app.rejki.id

# ── JWT (RS256) ──────────────────────────────────────────────────────────────
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000

# ── Encryption at Rest ──────────────────────────────────────────────────────
DATA_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# ── Firebase Cloud Messaging (PROD project) ─────────────────────────────────
# Letakkan service-account JSON di: /opt/rejki/keys/firebase-service-account-prod.json
FIREBASE_SERVICE_ACCOUNT_PATH=/app/keys/firebase-service-account-prod.json
FIREBASE_PROJECT_ID_PROD=rejki-prod

# ── Email / SMTP (PROD — gunakan SMTP real) ─────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@rejki.id
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
EMAIL_FROM=Rejki <noreply@rejki.id>

# ── MinIO (shared) ──────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=rejkiadmin
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET
MINIO_BUCKET=rejki-dokumen-prod

# ── Cloudflare Tunnel ───────────────────────────────────────────────────────
TUNNEL_TOKEN=CHANGE_ME_TUNNEL_TOKEN

# ── DB Backup ────────────────────────────────────────────────────────────────
S3_BACKUP_BUCKET=rejki-backups
BACKUP_SCHEDULE=0 3 * * *

# ── OpenTelemetry Auth (opsional — hanya jika pakai Grafana Cloud tracing) ──
# OTEL header untuk autentikasi ke collector. Endpoint sudah hardcoded di compose.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic {base64_credentials}

# ── Grafana Cloud / OpenTelemetry (opsional) ────────────────────────────────
# Uncomment & isi nilai dari Grafana Cloud stack Anda untuk mengaktifkan tracing.
# Setup: https://grafana.com/ → Grafana Cloud → OpenTelemetry → Send OpenTelemetry data
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-grpc.{zone}.grafana.net:4317
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic {base64_credentials}
