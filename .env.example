# ─────────────────────────────────────────────────────────────
# Rejki Backend — Environment Variables Template
# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit .env ke git.
# ─────────────────────────────────────────────────────────────
#
# TOPOLOGI ENVIRONMENT
#   Ada tiga konteks menjalankan aplikasi, dengan STRUKTUR variabel yang SAMA —
#   yang berbeda hanya NILAI-nya:
#     1. Local dev   : di mesin pengembang (Docker Compose), APP_ENV=development.
#     2. Dev di VPS   : /opt/rejki/dev  (compose project `rejki-dev`),  APP_ENV=development.
#     3. Prod di VPS  : /opt/rejki/prod (compose project `rejki-prod --profile prod`), APP_ENV=production.
#   Dev & prod hidup berdampingan di SATU VPS (port host & database berbeda).
#
# PEMBEDA dev vs prod (selain itu setara):
#   - Domain   : dev memakai SUBDOMAIN (mis. dev.rejki.id); prod memakai domain utama (mis. rejki.id).
#   - Swagger  : dev MENYAJIKAN Swagger UI (/swagger-ui); prod TIDAK (rute tidak dipasang).
#                Toggle ini otomatis dari APP_ENV — tidak ada variable khusus.
#   - nginx    : prod menambah rate limiting & JSON logging (nginx.prod.conf).
#   Karena struktur sama, secret & variable GitHub Actions pada dasarnya seragam
#   untuk dev & prod; hanya nilai environment-specific (domain, APP_ENV, token) berbeda.
# ─────────────────────────────────────────────────────────────

# Runtime environment: development | production — WAJIB di-set
# production → structured JSON logging; development → pretty logging + load .env
# development juga mengaktifkan Swagger UI di /swagger-ui (lihat catatan topologi di atas).
APP_ENV=development

# Log level: trace | debug | info | warn | error
RUST_LOG=info

# ── rejki-app (Composition Root) ─────────────────────────────
APP_PORT=8080
# CORS: daftar origin yang diizinkan di production (comma-separated).
# Default: https://rejki.id,https://app.rejki.id
# Development selalu allow_origin(Any) — tidak perlu set var ini.
CORS_ALLOWED_ORIGINS=https://rejki.id,https://app.rejki.id

# Shared database (satu PostgreSQL instance, schema terpisah per service)
DATABASE_URL=postgres://rejki:secret@localhost:5432/rejki_db

# ── Per-service database URL (untuk mode standalone binary) ──
# auth-service standalone binary kini membaca DATABASE_URL + APP_PORT (bukan service-specific)
# Konfigurasi lama AUTH_DATABASE_URL / AUTH_PORT dipertahankan untuk backward compat.
AUTH_DATABASE_URL=postgres://rejki:secret@localhost:5432/rejki_db
AUTH_PORT=3001

USER_DATABASE_URL=postgres://rejki:secret@localhost:5432/rejki_db
USER_PORT=3002

CHAT_DATABASE_URL=postgres://rejki:secret@localhost:5432/rejki_db
CHAT_PORT=3003

NOTIF_DATABASE_URL=postgres://rejki:secret@localhost:5432/rejki_db
NOTIF_PORT=3004

PEKERJAAN_DATABASE_URL=postgres://rejki:secret@localhost:5432/rejki_db
PEKERJAAN_PORT=3005

PEKERJA_DATABASE_URL=postgres://rejki:secret@localhost:5432/rejki_db
PEKERJA_PORT=3006

BARANG_DATABASE_URL=postgres://rejki:secret@localhost:5432/rejki_db
BARANG_PORT=3007

PELATIHAN_DATABASE_URL=postgres://rejki:secret@localhost:5432/rejki_db
PELATIHAN_PORT=3008

# ── JWT (RS256) ───────────────────────────────────────────────
# Generate keypair:
#   mkdir -p keys
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TTL_SECS=900        # 15 menit
JWT_REFRESH_TTL_SECS=2592000   # 30 hari

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Firebase Cloud Messaging (untuk bun-notification-service) ─
# Download service account dari Firebase Console:
#   Project Settings → Service accounts → Generate new private key
# Simpan ke keys/firebase-service-account.json (sudah di .gitignore)
FIREBASE_SERVICE_ACCOUNT_PATH=./keys/firebase-service-account.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# ── Email / SMTP (untuk bun-notification-service) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=noreply@rejki.id
SMTP_PASSWORD=app-password-here
EMAIL_FROM=Rejki <noreply@rejki.id>
